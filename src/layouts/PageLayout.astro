---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/navigation/Nav.astro';
import Footer from '../components/ui/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  darkHero?: boolean;
}

const { title, description, ogImage, darkHero = false } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <Nav darkHero={darkHero} />
  <main id="conteudo-principal">
    <slot />
  </main>
  <Footer />
</BaseLayout>
