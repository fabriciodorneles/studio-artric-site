---
import PageLayout from '../layouts/PageLayout.astro';
import CTA from '../components/sections/CTA.astro';

type Aula = {
  horario: string;
  titulo: string;
  professor?: string;
  publico?: string;
  cor: 'rouge' | 'teal' | 'gold' | 'velvet';
  href: string;
};

type DiaGrade = {
  label: string;
  aulas: Aula[];
};

const grade: DiaGrade[] = [
  {
    label: 'Seg / Qua',
    aulas: [
      { horario: '08:30 – 10:00', titulo: 'Acrobacia Aérea', publico: 'Adultos', professor: 'Pati Sousa', cor: 'rouge', href: '/cursos/acrobacia-aerea' },
      { horario: '16:30 – 17:30', titulo: 'Acrobacia Aérea', publico: 'Infantil / Juvenil (7+)', professor: 'Pati Sousa', cor: 'rouge', href: '/cursos/acrobacia-aerea' },
      { horario: '17:30 – 19:00', titulo: 'Acrobacia Aérea', publico: 'Turma Mista', professor: 'Pati Sousa', cor: 'rouge', href: '/cursos/acrobacia-aerea' },
      { horario: '19:00 – 20:30', titulo: 'Acrobacia Aérea', publico: 'Adultos', professor: 'Pati Sousa', cor: 'rouge', href: '/cursos/acrobacia-aerea' },
    ],
  },
  {
    label: 'Ter / Qui',
    aulas: [
      { horario: '08:30 – 10:00', titulo: 'Acrobacia Aérea', publico: 'Adultos', professor: 'Danilo Gomes', cor: 'rouge', href: '/cursos/acrobacia-aerea' },
      { horario: '18:30 – 20:00', titulo: 'Alongamento e Contorção', publico: 'Todos os níveis', professor: 'Pati Sousa', cor: 'teal', href: '/cursos/alongamento-contorcao' },
    ],
  },
  {
    label: 'Quinta',
    aulas: [
      { horario: '17:00 – 18:00', titulo: 'Ballet Adulto', publico: 'Adultos', professor: 'Bibi Araújo', cor: 'gold', href: '/cursos/ballet-adulto' },
    ],
  },
  {
    label: 'Sexta',
    aulas: [
      { horario: '09:30 – 10:30', titulo: 'Acrobacia de Solo + Aérea', publico: 'Crianças', professor: 'Pati Sousa', cor: 'velvet', href: '/cursos/acrobacia-solo-aerea' },
      { horario: '16:00 – 17:00', titulo: 'Acrobacia de Solo', publico: 'Crianças', professor: 'Pati Sousa', cor: 'velvet', href: '/cursos/acrobacia-solo' },
      { horario: '17:00 – 17:45', titulo: 'Ballet para Crianças', publico: 'Crianças', professor: 'Bibi Araújo', cor: 'gold', href: '/cursos/ballet-humanizado' },
      { horario: '18:00 – 19:00', titulo: 'Acrobacia de Solo', publico: 'Crianças', professor: 'Pati Sousa', cor: 'velvet', href: '/cursos/acrobacia-solo' },
    ],
  },
];

const corMap: Record<string, { bg: string; text: string; border: string; badge: string }> = {
  rouge: { bg: 'bg-[var(--color-rouge)]/8', text: 'text-[var(--color-rouge)]', border: 'border-[var(--color-rouge)]/40', badge: 'bg-[var(--color-rouge)]/10 text-[var(--color-rouge)]' },
  teal:  { bg: 'bg-[var(--color-teal)]/8',  text: 'text-[var(--color-teal)]',  border: 'border-[var(--color-teal)]/40',  badge: 'bg-[var(--color-teal)]/10 text-[var(--color-teal)]' },
  gold:  { bg: 'bg-[var(--color-gold)]/10', text: 'text-[var(--color-charcoal)]', border: 'border-[var(--color-gold)]/60', badge: 'bg-[var(--color-gold)]/20 text-yellow-700' },
  velvet:{ bg: 'bg-[var(--color-velvet)]/5', text: 'text-[var(--color-velvet)]', border: 'border-[var(--color-velvet)]/30', badge: 'bg-[var(--color-velvet)]/8 text-[var(--color-velvet)]' },
};
---

<PageLayout
  title="Horários"
  description="Grade de horários semanal do STUDIO ARTRIC — acrobacia aérea, alongamento e contorção, ballet e acrobacia de solo em Santa Teresa, Rio de Janeiro."
>
  <!-- Hero -->
  <section class="bg-[var(--color-velvet)] py-20 sm:py-24 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="font-accent italic text-[var(--color-gold)] text-xl mb-4">Planeje sua semana</p>
      <h1 class="font-display font-black text-white text-4xl sm:text-6xl mb-6">
        Grade de Horários
      </h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">
        Escolha o dia e o horário que melhor encaixa na sua rotina. Dúvidas? Entre em contato — adoramos te receber.
      </p>
    </div>
  </section>

  <!-- Grade semanal -->
  <section class="py-16 sm:py-24 bg-[var(--color-ivory)]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">

      <!-- Desktop: tabela -->
      <div class="hidden sm:block">
        <table class="w-full border-collapse">
          <thead>
            <tr>
              <th class="w-32 py-4 pr-6 text-left text-xs font-bold uppercase tracking-widest text-[var(--color-charcoal-light)]">Dia</th>
              <th class="py-4 text-left text-xs font-bold uppercase tracking-widest text-[var(--color-charcoal-light)]">Aulas</th>
            </tr>
          </thead>
          <tbody>
            {grade.map(({ label, aulas }) => (
              <tr class="border-t border-[var(--color-mist)]">
                <td class="py-5 pr-6 align-top">
                  <span class="font-display font-bold text-[var(--color-velvet)] text-lg leading-tight">{label}</span>
                </td>
                <td class="py-4">
                  <div class="flex flex-wrap gap-3">
                    {aulas.map((aula) => {
                      const c = corMap[aula.cor];
                      return (
                        <a
                          href={aula.href}
                          class={`group/card flex flex-col gap-1 rounded-xl border ${c.bg} ${c.border} px-5 py-3.5 min-w-[210px] max-w-[260px] hover:shadow-md transition-all duration-200`}
                        >
                          <span class="text-xs font-semibold text-[var(--color-charcoal-light)] tracking-wide">{aula.horario}</span>
                          <span class={`font-display font-bold text-base ${c.text} group-hover/card:underline leading-tight`}>{aula.titulo}</span>
                          {aula.publico && (
                            <span class={`self-start text-xs font-medium px-2 py-0.5 rounded-full ${c.badge}`}>{aula.publico}</span>
                          )}
                          {aula.professor && (
                            <span class="text-xs text-[var(--color-charcoal-light)] mt-0.5">{aula.professor}</span>
                          )}
                        </a>
                      );
                    })}
                  </div>
                </td>
              </tr>
            ))}
            <tr class="border-t border-[var(--color-mist)]">
              <td class="py-5 pr-6 align-top">
                <span class="font-display font-bold text-[var(--color-charcoal-light)]/40 text-lg">Sábado</span>
              </td>
              <td class="py-5">
                <span class="text-sm text-[var(--color-charcoal-light)]/40 italic">Sem aulas regulares no momento</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile: cards por dia -->
      <div class="sm:hidden space-y-8">
        {grade.map(({ label, aulas }) => (
          <div>
            <h2 class="font-display font-bold text-[var(--color-velvet)] text-xl mb-3 flex items-center gap-3">
              <span class="block w-6 h-0.5 bg-[var(--color-rouge)]" aria-hidden="true"></span>
              {label}
            </h2>
            <div class="space-y-3">
              {aulas.map((aula) => {
                const c = corMap[aula.cor];
                return (
                  <a
                    href={aula.href}
                    class={`flex flex-col gap-1 rounded-xl border ${c.bg} ${c.border} px-5 py-4 hover:shadow-md transition-all duration-200`}
                  >
                    <span class="text-xs font-semibold text-[var(--color-charcoal-light)] tracking-wide">{aula.horario}</span>
                    <span class={`font-display font-bold text-base ${c.text} leading-tight`}>{aula.titulo}</span>
                    {aula.publico && (
                      <span class={`self-start text-xs font-medium px-2 py-0.5 rounded-full ${c.badge}`}>{aula.publico}</span>
                    )}
                    {aula.professor && (
                      <span class="text-xs text-[var(--color-charcoal-light)] mt-0.5">{aula.professor}</span>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        ))}
        <div>
          <h2 class="font-display font-bold text-[var(--color-charcoal-light)]/40 text-xl mb-3 flex items-center gap-3">
            <span class="block w-6 h-0.5 bg-[var(--color-mist)]" aria-hidden="true"></span>
            Sábado
          </h2>
          <p class="text-sm text-[var(--color-charcoal-light)]/40 italic px-1">Sem aulas regulares no momento</p>
        </div>
      </div>

      <!-- Nota informativa -->
      <div class="mt-14 bg-white rounded-2xl p-6 sm:p-8 border border-[var(--color-mist)] flex flex-col sm:flex-row gap-5 items-start">
        <svg class="w-6 h-6 flex-shrink-0 text-[var(--color-teal)] mt-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
        </svg>
        <div>
          <p class="font-bold text-[var(--color-charcoal)] mb-1">Aula experimental gratuita</p>
          <p class="text-sm text-[var(--color-charcoal-light)] leading-relaxed">
            Os horários podem sofrer ajustes ao longo do ano. Para confirmar disponibilidade, agendar uma aula experimental gratuita
            ou tirar dúvidas, entre em contato pelo Instagram{' '}
            <a href="https://www.instagram.com/studioartric" target="_blank" rel="noopener noreferrer" class="text-[var(--color-rouge)] font-medium hover:underline">
              @studioartric
            </a>{' '}
            ou pelo WhatsApp <a href="https://wa.me/5521999947336" class="text-[var(--color-rouge)] font-medium hover:underline">(21) 99994-7336</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTA
    titulo="Pronto para começar?"
    subtitulo="Agende sua aula experimental gratuita e venha descobrir o que o movimento pode fazer por você."
    ctaTexto="Fale Conosco"
    ctaHref="/contato"
    ctaSecundarioTexto="Ver os cursos"
    ctaSecundarioHref="/cursos"
  />
</PageLayout>
