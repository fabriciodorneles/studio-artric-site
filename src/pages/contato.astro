---
import PageLayout from '../layouts/PageLayout.astro';
import ContatoForm from '../components/contato/ContatoForm.astro';
import ContatoInfo from '../components/contato/ContatoInfo.astro';
---

<PageLayout
  title="Contato"
  description="Entre em contato com o STUDIO ARTRIC. Tire dúvidas sobre cursos, workshops ou visite nosso estúdio em Santa Teresa, Rio de Janeiro."
>
  <!-- Hero -->
  <section class="bg-[var(--color-velvet)] py-20 sm:py-24 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="font-accent italic text-[var(--color-gold)] text-xl mb-4">Fale conosco</p>
      <h1 class="font-display font-black text-white text-4xl sm:text-6xl mb-6">Contato</h1>
      <p class="text-white/70 text-lg max-w-2xl mx-auto">
        Tire suas dúvidas, peça informações ou agende uma visita ao estúdio.
      </p>
    </div>
  </section>

  <!-- Conteúdo principal -->
  <section class="py-16 sm:py-24 bg-[var(--color-ivory)]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16">
        <!-- Formulário (maior) -->
        <div class="lg:col-span-3">
          <h2 class="font-display font-bold text-[var(--color-velvet)] text-3xl mb-8">
            Envie uma mensagem
          </h2>
          <ContatoForm />
        </div>

        <!-- Informações (menor) -->
        <div class="lg:col-span-2">
          <h2 class="font-display font-bold text-[var(--color-velvet)] text-3xl mb-8">
            Outras formas
          </h2>
          <ContatoInfo />
        </div>
      </div>
    </div>
  </section>

  <!-- Mapa -->
  <section class="h-80 sm:h-96 bg-[var(--color-mist)]" aria-label="Localização no mapa">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3674.447748987461!2d-43.18247052478879!3d-22.919399538303086!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x997e6c42d2a7af%3A0x8d6d2be72b2b70f3!2sRua%20Almirante%20Alexandrino%2C%20501%20-%20Santa%20Teresa%2C%20Rio%20de%20Janeiro%20-%20RJ!5e0!3m2!1spt-BR!2sbr!4v1699999999999!5m2!1spt-BR!2sbr"
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Localização do STUDIO ARTRIC no Google Maps"
    ></iframe>
  </section>
</PageLayout>
