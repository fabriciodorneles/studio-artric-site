---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/sections/Hero.astro';
import DestaquesHome from '../components/sections/DestaquesHome.astro';
import SobrePreview from '../components/sections/SobrePreview.astro';
import CTA from '../components/sections/CTA.astro';
---

<PageLayout
  title="Início"
  description="STUDIO ARTRIC — Artes Recreativas Integradas ao Circo. Aulas de acrobacia aérea, contorção, breaking e dança em Santa Teresa, Rio de Janeiro. Desde 2013."
  darkHero={true}
>
  <Hero />

  <DestaquesHome />

  <SobrePreview />

  <!-- Chamada para horários -->
  <section class="py-16 sm:py-20 bg-[var(--color-mist)]/40">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="font-accent italic text-[var(--color-teal)] text-lg mb-3">Organize sua semana</p>
      <h2 class="font-display font-bold text-[var(--color-velvet)] text-3xl sm:text-4xl mb-4">
        Confira a grade de horários
      </h2>
      <p class="text-[var(--color-charcoal-light)] text-lg max-w-xl mx-auto mb-8">
        Aulas de segunda a sábado. Encontre o dia e o horário ideal para você.
      </p>
      <a
        href="/horarios"
        class="inline-flex items-center gap-2 bg-[var(--color-velvet)] text-white font-bold text-sm px-8 py-4 rounded-full hover:bg-[var(--color-velvet-light)] transition-colors duration-200"
      >
        Ver grade de horários
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <CTA />
</PageLayout>
