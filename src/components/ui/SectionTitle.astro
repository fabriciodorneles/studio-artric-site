---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
  light?: boolean;
}

const { eyebrow, title, subtitle, center = false, light = false } = Astro.props;
---

<div class:list={['mb-10 sm:mb-14', center && 'text-center']}>
  {
    eyebrow && (
      <p
        class:list={[
          'font-accent italic text-lg sm:text-xl mb-2',
          light ? 'text-[var(--color-gold)]' : 'text-[var(--color-rouge)]',
        ]}
      >
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      'font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-balance',
      light ? 'text-white' : 'text-[var(--color-velvet)]',
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          'mt-4 text-lg leading-relaxed max-w-2xl',
          center && 'mx-auto',
          light ? 'text-white/70' : 'text-[var(--color-charcoal-light)]',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
