---
interface Props {
  titulo?: string;
  subtitulo?: string;
  ctaTexto?: string;
  ctaHref?: string;
  ctaSecundarioTexto?: string;
  ctaSecundarioHref?: string;
}

const {
  titulo = 'Movimento, técnica\ne conexão humana.',
  subtitulo = 'Circo, acrobacia aérea, breaking e dança no coração de Santa Teresa, Rio de Janeiro. Desde 2013.',
  ctaTexto = 'Conheça os cursos',
  ctaHref = '/cursos',
  ctaSecundarioTexto = 'Fale conosco',
  ctaSecundarioHref = '/contato',
} = Astro.props;
---

<section
  class="relative min-h-screen flex items-center justify-center bg-[var(--color-velvet)] overflow-hidden"
  aria-label="Apresentação do Studio ARTRIC"
>
  <!-- Foto de fundo real do estúdio -->
  <div class="absolute inset-0" aria-hidden="true">
    <img
      src="/images/hero-bg.jpg"
      alt=""
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Overlay escuro para legibilidade do texto -->
    <div class="absolute inset-0 bg-[var(--color-velvet)]/75"></div>
  </div>

  <!-- Fundo decorativo: círculos geométricos -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Círculo grande (argola de lira) -->
    <div
      class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full border border-white/5"
    >
    </div>
    <div
      class="absolute -top-24 -right-24 w-[500px] h-[500px] rounded-full border border-white/5"
    >
    </div>
    <!-- Acento dourado -->
    <div
      class="absolute bottom-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-[var(--color-gold)]/40 to-transparent"
    >
    </div>
    <!-- Pontos decorativos -->
    <div
      class="absolute top-1/3 left-8 sm:left-16 w-2 h-2 rounded-full bg-[var(--color-gold)]/30"
    >
    </div>
    <div
      class="absolute top-2/3 left-12 sm:left-24 w-1 h-1 rounded-full bg-[var(--color-rouge)]/40"
    >
    </div>
    <div
      class="absolute top-1/4 right-12 sm:right-20 w-3 h-3 rounded-full bg-[var(--color-teal)]/20"
    >
    </div>
    <!-- Linha vertical decorativa -->
    <div
      class="absolute top-24 left-1/2 -translate-x-1/2 w-px h-16 bg-gradient-to-b from-[var(--color-gold)]/40 to-transparent"
    >
    </div>
  </div>

  <!-- Conteúdo -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center pt-24 pb-16">
    <!-- Eyebrow -->
    <p
      class="font-accent italic text-[var(--color-gold)] text-xl sm:text-2xl mb-6 animate-fade-in"
    >
      Studio ARTRIC
    </p>

    <!-- Título principal -->
    <h1
      class="font-display font-black text-white text-4xl sm:text-6xl lg:text-7xl leading-tight mb-8 text-balance animate-fade-in-up"
      style="animation-delay: 100ms;"
    >
      {
        titulo.split('\n').map((linha, i) => (
          <>
            {i === 1 ? (
              <span class="text-[var(--color-gold)]">{linha}</span>
            ) : (
              linha
            )}
            {i < titulo.split('\n').length - 1 && <br />}
          </>
        ))
      }
    </h1>

    <!-- Subtítulo -->
    <p
      class="text-white/70 text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto mb-10 animate-fade-in-up"
      style="animation-delay: 200ms;"
    >
      {subtitulo}
    </p>

    <!-- CTAs -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up"
      style="animation-delay: 300ms;"
    >
      <a
        href={ctaHref}
        class="w-full sm:w-auto bg-[var(--color-rouge)] text-white font-bold text-base px-8 py-4 rounded-full hover:bg-[var(--color-rouge-light)] transition-all duration-200 active:scale-95"
      >
        {ctaTexto}
      </a>
      <a
        href={ctaSecundarioHref}
        class="w-full sm:w-auto border-2 border-white/30 text-white font-bold text-base px-8 py-4 rounded-full hover:border-white/60 hover:bg-white/5 transition-all duration-200 active:scale-95"
      >
        {ctaSecundarioTexto}
      </a>
    </div>

    <!-- Localização -->
    <p
      class="mt-12 text-white/40 text-sm flex items-center justify-center gap-2 animate-fade-in"
      style="animation-delay: 500ms;"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
        ></path>
      </svg>
      Santa Teresa, Rio de Janeiro
    </p>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30 animate-bounce"
    aria-hidden="true"
  >
    <span class="text-xs uppercase tracking-widest">Role</span>
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 9l6 6 6-6"></path>
    </svg>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out both;
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out both;
  }
</style>
