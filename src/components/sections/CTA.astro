---
interface Props {
  titulo?: string;
  subtitulo?: string;
  ctaTexto?: string;
  ctaHref?: string;
  ctaSecundarioTexto?: string;
  ctaSecundarioHref?: string;
}

const {
  titulo = 'Pronto para começar?',
  subtitulo = 'Venha conhecer o Studio ARTRIC. Sua primeira aula pode mudar tudo.',
  ctaTexto = 'Fale Conosco',
  ctaHref = '/contato',
  ctaSecundarioTexto = 'Ver todos os cursos',
  ctaSecundarioHref = '/cursos',
} = Astro.props;
---

<section class="py-20 sm:py-28 bg-[var(--color-rouge)] relative overflow-hidden">
  <!-- Decoração geométrica -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <div
      class="absolute -top-24 -right-24 w-96 h-96 rounded-full border border-white/10"
    >
    </div>
    <div
      class="absolute -bottom-16 -left-16 w-64 h-64 rounded-full border border-white/10"
    >
    </div>
  </div>

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="font-display font-bold text-white text-4xl sm:text-5xl mb-4 text-balance">
      {titulo}
    </h2>
    <p class="text-white/80 text-lg mb-10">
      {subtitulo}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={ctaHref}
        class="w-full sm:w-auto bg-white text-[var(--color-rouge)] font-bold text-base px-8 py-4 rounded-full hover:bg-[var(--color-ivory)] transition-all duration-200 active:scale-95"
      >
        {ctaTexto}
      </a>
      <a
        href={ctaSecundarioHref}
        class="w-full sm:w-auto border-2 border-white/40 text-white font-bold text-base px-8 py-4 rounded-full hover:border-white/70 hover:bg-white/10 transition-all duration-200 active:scale-95"
      >
        {ctaSecundarioTexto}
      </a>
    </div>
  </div>
</section>
