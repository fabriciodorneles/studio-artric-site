---
import Badge from '../ui/Badge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  curso: CollectionEntry<'cursos'>;
}

const { curso } = Astro.props;
const { titulo, descricao, categoria, nivel, diasSemana, horario, professor, preco, destaque } =
  curso.data;

const categoriaGradient: Record<string, string> = {
  aéreo: 'from-[var(--color-teal)] to-teal-700',
  acrobacia: 'from-[var(--color-rouge)] to-red-800',
  dança: 'from-purple-600 to-purple-900',
  teatro: 'from-amber-600 to-amber-900',
  infantil: 'from-yellow-500 to-orange-500',
};

const gradient = categoriaGradient[categoria] ?? 'from-[var(--color-velvet)] to-gray-800';
---

<article
  class="group bg-white rounded-[var(--radius-card)] overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col"
>
  <!-- Faixa colorida de categoria -->
  <div class:list={['h-3 bg-gradient-to-r', gradient]} aria-hidden="true"></div>

  <div class="p-6 flex flex-col flex-1">
    <!-- Badges -->
    <div class="flex flex-wrap gap-2 mb-4">
      <Badge variant="categoria" value={categoria} />
      <Badge variant="nivel" value={nivel} />
      {destaque && (
        <span class="inline-block text-xs font-bold uppercase tracking-wide px-2.5 py-1 rounded-full bg-[var(--color-gold)]/20 text-yellow-700">
          Destaque
        </span>
      )}
    </div>

    <!-- Título -->
    <h3 class="font-display font-bold text-[var(--color-velvet)] text-xl mb-3 group-hover:text-[var(--color-rouge)] transition-colors">
      {titulo}
    </h3>

    <!-- Descrição -->
    <p class="text-[var(--color-charcoal-light)] text-sm leading-relaxed mb-4 flex-1 line-clamp-3">
      {descricao}
    </p>

    <!-- Detalhes -->
    <dl class="space-y-2 mb-6 text-sm">
      <div class="flex items-center gap-2 text-[var(--color-charcoal-light)]">
        <svg class="w-4 h-4 flex-shrink-0 text-[var(--color-rouge)]/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/>
        </svg>
        <dt class="sr-only">Dias</dt>
        <dd>{diasSemana.join(' e ')}</dd>
      </div>
      <div class="flex items-center gap-2 text-[var(--color-charcoal-light)]">
        <svg class="w-4 h-4 flex-shrink-0 text-[var(--color-rouge)]/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/>
        </svg>
        <dt class="sr-only">Horário</dt>
        <dd>{horario}</dd>
      </div>
      {professor && (
        <div class="flex items-center gap-2 text-[var(--color-charcoal-light)]">
          <svg class="w-4 h-4 flex-shrink-0 text-[var(--color-rouge)]/60" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
          </svg>
          <dt class="sr-only">Professor</dt>
          <dd>{professor}</dd>
        </div>
      )}
    </dl>

    <!-- Rodapé -->
    <div class="flex items-center justify-between mt-auto pt-4 border-t border-[var(--color-mist)]">
      {preco ? (
        <span class="text-[var(--color-velvet)] font-bold text-sm">{preco}</span>
      ) : (
        <span class="text-[var(--color-charcoal-light)] text-sm">Consulte valores</span>
      )}
      <a
        href={`/cursos/${curso.id}`}
        class="text-sm font-bold text-[var(--color-rouge)] hover:text-[var(--color-rouge-light)] flex items-center gap-1 transition-all duration-200 group-hover:gap-2"
        aria-label={`Ver detalhes do curso ${titulo}`}
      >
        Saiba mais
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>
